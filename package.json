  "repository": { "type": "git", "url": "git+https://github.com/nwebersoftware/manifest-check.git" },
  "homepage": "https://github.com/nwebersoftware/manifest-check#readme",
  "bugs": { "url": "https://github.com/nwebersoftware/manifest-check/issues" },
